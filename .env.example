

# MySQL 8 (docker compose maps host 3307 → container 3306)
DATABASE_URL=mysql://root:trender@127.0.0.1:3307/trender
REDIS_URL=redis://127.0.0.1:6380
# Namespaces every Redis/BullMQ key. Use a distinct value per env on a shared instance.
REDIS_PREFIX=trender
SESSION_SECRET=replace-with-at-least-32-random-characters
# Public origin (no trailing slash)
APP_URL=http://localhost:3000

# GrokBot / external trigger. Authorization: Bearer <this>
TRENDER_API_KEY=

# Raw 64-byte Solana secret as base64. Required to mint and to sweep creator fees.
# Never auto-generated. Never commit.
TREASURY_SECRET=

# Skip the hourly collect when the Pump creator vault is below this SOL amount.
FEE_SWEEP_MIN_SOL=0.05

# USD of SOL the treasury spends on the Pump curve right after mint. 0 skips.
LAUNCH_BUY_USD=10

SOLANA_RPC_URL=
# Optional. Pin the treasury Address Lookup Table that packs create+buy into one packet.
# Created automatically on first mint if unset.
PUMP_ALT_ADDRESS=

XAI_API_KEY=
XAI_TEXT_MODEL=grok-4-1-fast-non-reasoning
XAI_IMAGE_MODEL=grok-imagine-image-2.0

# DigitalOcean Spaces + CDN. Pump metadata must be public HTTPS.
SPACES_ENDPOINT=
SPACES_REGION=nyc3
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=
SPACES_CDN_BASE=

# Optional. Hydrate tweet_url when GrokBot omits text/media/avatar.
X_BEARER_TOKEN=
